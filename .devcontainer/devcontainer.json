{
  "name": "Architecture Review Agent",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "AZURE_RESOURCE_GROUP": "rg-architecture-review-workshop"
  },
  "postCreateCommand": "python -m pip install -r 00-setup/requirements.txt -r 01-standards-agent/requirements.txt && az bicep install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-bicep",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  }
}
